# Nexora Environment Example
# Copy to .env and fill values

SECRET_KEY=change-me-to-random-string
DATABASE_URL=
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-sender@example.com
BREVO_SENDER_NAME=Nexora
APP_BASE_URL=http://localhost:5000
FLASK_ENV=production
PYTHON_VERSION=3.12.0

# Admin provisioning (optional)
ADMIN_USERNAME=nexora_admin
ADMIN_PASSWORD=change-me-12-chars-min
ADMIN_RECOVERY_ENABLED=false
ADMIN_RECOVERY_USERNAME=
ADMIN_RECOVERY_PASSWORD=
ADMIN_RECOVERY_EMAIL=

# Database (default sqlite, set DATABASE_URL for postgres)
DATABASE_URL=
